# ── 墨卷 MoJuan 环境变量模板 ─────────────────────────────────────────
# 用法：复制为 .env（.env 已被 .gitignore 忽略，不会进入仓库）
#
# 优先级：界面保存的配置（data/settings.json） > 本文件 > 内置预设
# 也就是说：这里只是"默认值"，真正日常修改请在 http://127.0.0.1:4000/#/settings 里点。
#
# 【零配置演示】整份文件留空也能跑：
#   没有任何可用接入时，服务自动进入 DEMO_MODE，用内置录制流回放完整闭环。
# -------------------------------------------------------------------

# 接入方式：deepseek | ollama | lmstudio | custom
LLM_PROVIDER=deepseek

# 云端 API Key（DeepSeek 必填；本地模型通常留空）
DEEPSEEK_API_KEY=

# 接口地址：云端填 https://api.deepseek.com
# 本地 Ollama 填 http://127.0.0.1:11434/v1
# 本地 LM Studio 填 http://127.0.0.1:1234/v1
LLM_BASE_URL=https://api.deepseek.com

# 模型名：云端 deepseek-flash / deepseek-v4-pro；本地填 ollama 里的模型名
LLM_MODEL=deepseek-flash

# 单次模型调用超时（毫秒）。本地小模型首次加载慢，可调大到 180000
LLM_TIMEOUT_MS=90000

# 服务端口
PORT=4000

# 持久化驱动：auto | sqlite | json
#   auto   = Node 内置 node:sqlite 可用则用 sqlite，否则自动降级为 json
#   sqlite = 强制 SQLite（需要 Node >= 22.5）
#   json   = 强制 JSON 文件存储（零依赖，任何 Node 版本可用）
DB_DRIVER=auto
